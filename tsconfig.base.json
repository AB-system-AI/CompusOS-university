{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@campusos/config": ["packages/config/src/index.ts"],
      "@campusos/common": ["packages/common/src/index.ts"],
      "@campusos/events": ["packages/events/src/index.ts"],
      "@campusos/auth": ["packages/auth/src/index.ts"],
      "@campusos/i18n": ["packages/i18n/src/index.ts"],
      "@campusos/api-client": ["packages/api-client/src/index.ts"],
      "@campusos/database": ["packages/database/src/index.ts"],
      "@campusos/proto": ["packages/proto/src/index.ts"],
      "@campusos/testing": ["packages/testing/src/index.ts"],
      "@campusos/ui": ["packages/ui/src/index.ts"],
      "@campusos/web": ["apps/web/src/index.ts"],
      "@campusos/admin": ["apps/admin/src/index.ts"],
      "@campusos/cms": ["apps/cms/src/index.ts"],
      "@campusos/mobile": ["apps/mobile/src/index.ts"],
      "@campusos/api-gateway": ["apps/api-gateway/src/index.ts"],
      "@campusos/identity-service": ["services/identity/src/index.ts"],
      "@campusos/tenant-service": ["services/tenant/src/index.ts"],
      "@campusos/communicate-service": ["services/communicate/src/index.ts"],
      "@campusos/content-service": ["services/content/src/index.ts"],
      "@campusos/trust-service": ["services/trust/src/index.ts"],
      "@campusos/platform-service": ["services/platform/src/index.ts"],
      "@campusos/insight-service": ["services/insight/src/index.ts"],
      "@campusos/search-service": ["services/search/src/index.ts"],
      "@campusos/web-service": ["services/web/src/index.ts"],
      "@campusos/ai-gateway-service": ["services/ai-gateway/src/index.ts"],
      "@campusos/eslint-config": ["tooling/eslint-config/index.js"],
      "@campusos/typescript-config": ["tooling/typescript-config/src/index.ts"]
    },
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", ".turbo", "coverage"]
}
